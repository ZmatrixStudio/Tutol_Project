                </p>
                <div class="btn-group">
                    <a href="#contact" class="btn btn-primary">
                         Tìm Gia Sư Ngay <i class="fa-solid fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </section>

        <section id="about" class="padding">
            <div class="about-container">
                <div class="about-text">
                    <h4>Về chúng tôi</h4>
